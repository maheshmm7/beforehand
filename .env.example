# Copy to .env and fill in. Never commit .env.
# A Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults are gemini-3.6-flash and gemini-3.5-flash.
# Defaults are used when these are absent.
# Leaving a variable present but EMPTY is treated as absent.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
PORT=

# How many proxies sit in front of this server. Every hop in x-forwarded-for
# beyond this count is written by the client and is ignored. 0 by default,
# which trusts the header not at all; Vercel sets its own marker and is
# treated as 1. Set this only if you know what is in front of you.
TRUSTED_PROXY_HOPS=
